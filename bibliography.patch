+// ── Sub-components ─────────────────────────────────────────────────────────
+
+function TypeBadge({ type }: { type: SourceType }) {
+  const s = TYPE_STYLES[type];
+  return (
+    <span style={{
+      display: 'inline-block',
+      fontSize: '0.72rem',
+      fontFamily: 'var(--font-ui)',
+      fontWeight: 500,
+      letterSpacing: '0.08em',
+      textTransform: 'uppercase',
+      padding: '0.2rem 0.6rem',
+      borderRadius: '3px',
+      background: s.bg,
+      color: s.color,
+      border: `1px solid ${s.border}`,
+      marginBottom: '0.5rem',
+      whiteSpace: 'nowrap',
+    }}>
+      {type}
+    </span>
+  );
+}
+
+function BibCard({ entry }: { entry: BibEntry }) {
+  return (
+    <div className={researchStyles.refItem} style={{ marginBottom: '1.25rem' }}>
+      <TypeBadge type={entry.type} />
+      <p style={{ marginBottom: '0.3rem' }}>
+        <strong style={{ color: 'var(--text-primary)' }}>{entry.author}</strong>
+        {' '}
+        <span style={{ color: 'var(--text-muted)', fontSize: '0.9rem' }}>({entry.year}).</span>
+        {' '}
+        <em style={{ color: 'var(--gold-light)' }}>{entry.title}.</em>
+        {entry.publisher && (
+          <span style={{ color: 'var(--text-muted)', fontSize: '0.9rem' }}> {entry.publisher}</span>
+        )}
+      </p>
+      <p style={{ fontSize: '0.875rem', color: 'var(--text-muted)', margin: '0.4rem 0' }}>
+        {entry.note}
+      </p>
+      {entry.url && (
+        <a
+          href={entry.url}
+          target="_blank"
+          rel="noopener noreferrer"
+          className={researchStyles.refLink}
+          style={{ fontSize: '0.85rem' }}
+        >
+          {entry.urlLabel ?? 'Access online'} &rarr;
+        </a>
+      )}
+    </div>
+  );
+}
